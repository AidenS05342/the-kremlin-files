			chicago: 'Savranskaya, Svetlana, ed. “The August 1991 Coup in Moscow, 20 Years Later.” National Security Archive Electronic Briefing Book No. 357. Washington, DC: National Security Archive, George Washington University, 2011. https://nsarchive2.gwu.edu/NSAEBB/NSAEBB357/.'
		}
	};
}());



:: helpers.js [script]
/* Small presentation helpers. Node-safe: references only `setup`. */
(function () {
	'use strict';

	var MINDS = {
		loyalty: 'You keep telling yourself the Party will hold.',
		reform: 'You keep thinking about the people outside.',
		survival: 'You keep thinking about your family.'
	};

	setup.stateOfMind = function (v) {
		var best = null;
		var top = 0;
		['loyalty', 'reform', 'survival'].forEach(function (k) {
			if (v.pulls[k] > top) { top = v.pulls[k]; best = k; }
		});
		return best ? MINDS[best] : 'You keep your head down and do your work.';
	};

	setup.sortedGlossary = function (v) {
		return v.glossary.slice().sort(function (a, b) {
			return setup.glossary[a].ru.localeCompare(setup.glossary[b].ru, 'ru');
		});
	};

	setup.sourcesByType = function (type) {
		var plain = function (k) { return setup.sources[k].chicago.replace(/<[^>]+>/g, ''); };
		return Object.keys(setup.sources)
			.filter(function (k) { return setup.sources[k].type === type; })
			.sort(function (a, b) { return plain(a).localeCompare(plain(b)); });
	};

	setup.plainTitle = function (noteId) {
		return setup.notes[noteId].title.replace(/<[^>]+>/g, '');
	};
}());



:: registry.js [script]
/*
 * Registry terminal search. Node-safe: references only `setup`.
 * Data lives in setup.registry (src/scripts/data/registry.js).
 */
(function () {
	'use strict';

	// Latin letters that look identical to Cyrillic ones on a 1991 keyboard layout.
	var LOOKALIKE = { a: 'а', c: 'с', e: 'е', o: 'о', p: 'р', x: 'х', k: 'к', m: 'м', t: 'т', b: 'в', h: 'н', y: 'у' };
	var NEEDS_MAP = /[0-9Ѐ-ӿ]/;

	function mapToken(token) {
		if (!NEEDS_MAP.test(token)) { return token; }
		return token.replace(/[a-z]/g, function (ch) { return LOOKALIKE[ch] || ch; });
	}

	setup.normalizeQuery = function (q) {
		return String(q || '').trim().toLowerCase().split(/\s+/).map(mapToken).join(' ');
	};

	function hasAccess(entry, v) {
		var clues = entry.requiresClues || [];
		var allClues = clues.every(function (id) { return v.clues.indexOf(id) !== -1; });
		if (allClues) { return true; }
		var t = entry.unlockTrust;
		return !!(t && v.trust[t.who] >= t.min);
	}

	var ACTS = ['prologue', 'act1', 'act2', 'act3', 'epilogue'];

	/* A record with `fromAct` is not registered yet before that act. */
	function existsYet(entry, v) {
		if (!entry.fromAct || !v.act) { return true; }
		return ACTS.indexOf(v.act) >= ACTS.indexOf(entry.fromAct);
	}

	setup.searchRegistry = function (query, v) {
		var q = setup.normalizeQuery(query);
		var entries = setup.registry || [];
		for (var i = 0; i < entries.length; i++) {
			var e = entries[i];
			var match = e.keys.some(function (k) { return setup.normalizeQuery(k) === q; });
			if (!match || !existsYet(e, v)) { continue; }
			if (hasAccess(e, v)) {
				var found = { status: 'found', lines: e.foundLines.slice() };
				if (e.docId) { found.docId = e.docId; }
				return found;
			}
			return { status: 'restricted', lines: e.restrictedLines.slice() };
		}
		return { status: 'notfound', lines: ['ЗАПИСЬ НЕ НАЙДЕНА', 'RECORD NOT FOUND'] };
	};
}());



:: state.js [script]
/*
 * Game-state rules. Node-safe: references only the global `setup` at load time.
 * Every helper takes SugarCube's variables object (State.variables) as `v`.
 */
(function () {
	'use strict';

	setup.TRUST_MIN = -3;
	setup.TRUST_MAX = 3;
	setup.EXPOSURE_THRESHOLD = 5;

	var PULLS = ['loyalty', 'reform', 'survival'];
	var DOC_FIELDS = ['seen', 'held', 'copied', 'destroyed', 'handed'];

	setup.newGame = function () {
		return {
			trust: { rudin: 0, belova: 0, zaitsev: 0, markova: 0 },
			pulls: { loyalty: 0, reform: 0, survival: 0 },
			exposure: 0,
			flags: {},
			docs: {},
			clues: [],
			glossary: [],
			notesSeen: [],
			tray: [],
			kept: [],
			phone: null,
			act: 'prologue',
			date: '12 АВГ 1991',
			time: '09:00',
			returnTo: 'Start'
		};
	};

	setup.adjustTrust = function (v, who, delta) {
		if (!Object.prototype.hasOwnProperty.call(v.trust, who)) {
			throw new Error('adjustTrust: unknown character "' + who + '"');
		}
		var next = v.trust[who] + delta;
		v.trust[who] = Math.max(setup.TRUST_MIN, Math.min(setup.TRUST_MAX, next));
		return v.trust[who];
	};

	setup.addPull = function (v, which, n) {
		if (PULLS.indexOf(which) === -1) {
			throw new Error('addPull: unknown pull "' + which + '"');
		}
		v.pulls[which] += n;
	};

	setup.addExposure = function (v, n) {
		v.exposure += n;
		return v.exposure;
	};

	setup.markClue = function (v, id) {
		if (v.clues.indexOf(id) !== -1) { return false; }
		v.clues.push(id);
		return true;
	};

	setup.setDoc = function (v, id, field, value) {
		if (DOC_FIELDS.indexOf(field) === -1) {
			throw new Error('setDoc: unknown field "' + field + '"');
		}
		if (!v.docs[id]) {
			v.docs[id] = { seen: false, held: false, copied: false, destroyed: false, handed: false };
		}
		v.docs[id][field] = value === undefined ? true : value;
	};

	/* Exposure overrides everything; otherwise the final decision about the files decides.
	   A player who never acts on the files is carried along by the institution. */
	setup.resolveEnding = function (v) {
		if (v.exposure >= setup.EXPOSURE_THRESHOLD) { return 'scapegoat'; }
		switch (v.flags.finalDecision) {
			case 'kept': return 'survivor';
			case 'handed': return 'witness';
			default: return 'loyalist';
		}
	};
}());



:: config.js [script]
/* SugarCube configuration and passage bookkeeping (browser only). */
(function () {
	'use strict';

	/* One history state: the browser Back button cannot undo a decision. */
	Config.history.maxStates = 1;
	Config.history.controls = false;
	/* Autosave every story passage, but never the title screen or academic pages,
	   so returning to the title does not overwrite progress. */
	Config.saves.autosave = ['scene', 'document', 'conversation', 'phone', 'terminal', 'bulletin', 'side', 'stub', 'ending'];
	Config.saves.slots = 6;
	/* Blank lines become paragraphs; layout passages use the `nobr` tag. */
	Config.cleanupWikifierOutput = true;

	$(document).on(':passagestart', function (ev) {
		var v = State.variables;
		var tags = ev.passage.tags;
		$('html').attr('data-kind', tags.join(' '));
		if (tags.indexOf('academic') === -1) {
			v.backTo = ev.passage.title;
		}
		if (tags.indexOf('scene') !== -1) {
			v.returnTo = ev.passage.title;
		}
		if (tags.indexOf('document') !== -1) {
			Object.keys(setup.documents).forEach(function (id) {
				if (setup.documents[id].passage === ev.passage.title) {
					setup.setDoc(v, id, 'seen');
				}
			});
		}
	});
}());

/* Favicon: a red star, drawn inline (no image file needed). */
(function () {
	'use strict';
	var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><polygon fill="%23a3201a" points="50,4 61,38 97,38 68,59 79,94 50,72 21,94 32,59 3,38 39,38"/></svg>';
	$('<link rel="icon" type="image/svg+xml">').attr('href', 'data:image/svg+xml,' + svg).appendTo('head');
}());



:: macros.js [script]
/* Custom macros: <<ru>>, <<note>>, <<clue>>…<</clue>>, <<returnlink>> (browser only). */
(function () {
	'use strict';

	function pushOnce(list, id) {
		if (list.indexOf(id) === -1) { list.push(id); }
	}

	function toast(text) {
		var el = $('<div class="toast" role="status"></div>').text(text).appendTo('body');
		setTimeout(function () { el.addClass('toast--out'); }, 1800);
		setTimeout(function () { el.remove(); }, 2400);
	}
	setup.toast = toast;

	/* <<ru "id" ["display text"]>> — Russian term with tooltip; records it in the Dictionary. */
	Macro.add('ru', {
		handler: function () {
			var id = this.args[0];
			var g = setup.glossary[id];
			if (!g) { return this.error('unknown glossary id "' + id + '"'); }
			pushOnce(State.variables.glossary, id);
			var tip = g.ru + ' · ' + g.translit + ' · ' + g.en;
			$('<span class="ru" tabindex="0"></span>')
				.attr({ 'data-tip': tip, 'aria-label': (this.args[1] || g.ru) + ' (' + g.translit + ': ' + g.en + ')' })
				.text(this.args[1] || g.ru)
				.appendTo(this.output);
		}
	});

	/* <<note "id">> — historical-note stamp; opens the note with its citations. */
	setup.openNote = function (id) {
		var n = setup.notes[id];
		pushOnce(State.variables.notesSeen, id);
		var html = '<p class="note-date">' + n.date + '</p><p>' + n.body + '</p>';
		var STATUS = {
			verified: 'Verified (November 2026) against the sources below. Book sources are general support; no page numbers have been confirmed.',
			partial: 'Partly verified (November 2026). Still to check: ',
			reconstruction: 'Reconstruction: not a documented historical object. '
		};
		if (n.sources && n.sources.length) {
			html += '<h3>Sources</h3><ul class="note-sources">' + n.sources.map(function (key) {
				var loc = n.locators && n.locators[key];
				return '<li>' + setup.sources[key].chicago + (loc ? ' <span class="note-loc">— ' + loc + '</span>' : '') + '</li>';
			}).join('') + '</ul>';
		}
		html += '<p class="note-flag note-flag--' + n.status + '">' + STATUS[n.status] + (n.status === 'verified' ? '' : (n.remaining || '')) + '</p>';
		Dialog.setup('ИСТОРИЧЕСКАЯ СПРАВКА · ' + n.title, 'note-dialog');
		Dialog.append(html);
		Dialog.open();
	};

	Macro.add('note', {
		handler: function () {
			var id = this.args[0];
			if (!setup.notes[id]) { return this.error('unknown note id "' + id + '"'); }
			$('<button type="button" class="note-stamp"></button>')
				.attr('title', 'Historical note: ' + $('<span>').html(setup.notes[id].title).text())
				.html('<span lang="ru">ИСТОРИЧЕСКАЯ СПРАВКА</span><small>historical note</small>')
				.on('click', function () { setup.openNote(id); })
				.appendTo(this.output);
		}
	});

	/* <<clue "id">>text<</clue>> — a key phrase the player can mark into the notebook. */
	Macro.add('clue', {
		tags: null,
		handler: function () {
			var id = this.args[0];
			if (!setup.clues[id]) { return this.error('unknown clue id "' + id + '"'); }
			var btn = $('<button type="button" class="clue"></button>')
				.attr('aria-label', 'Mark clue: ' + setup.clues[id].label)
				.wiki(this.payload[0].contents)
				.appendTo(this.output);
			if (State.variables.clues.indexOf(id) !== -1) { btn.addClass('marked').attr('aria-pressed', 'true'); }
			btn.on('click', function () {
				if (setup.markClue(State.variables, id)) {
					toast('Записано · Recorded in notebook');
				}
				btn.addClass('marked').attr('aria-pressed', 'true');
			});
		}
	});

	/* <<returnlink ["label"]>> — back to the last main-line scene. */
	Macro.add('returnlink', {
		handler: function () {
			var target = State.variables.returnTo || 'Start';
			$('<button type="button" class="return-link"></button>')
				.text(this.args[0] || '← Return to desk')
				.on('click', function () { Engine.play(target); })
				.appendTo(this.output);
		}
	});
}());



:: terminal.js [script]
/* Registry terminal rendering: typed output, search, chips (browser only). */
(function () {
	'use strict';

	var reduced = function () {
		return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	};
	var queue = Promise.resolve();

	function typeLine(out, text, cls) {
		queue = queue.then(function () {
			return new Promise(function (resolve) {
				var line = $('<div class="term-line"></div>').addClass(cls || '').appendTo(out);
				out.scrollTop(out.prop('scrollHeight'));
				if (reduced()) { line.text(text); resolve(); return; }
				var i = 0;
				(function step() {
					i += 2;
					line.text(text.slice(0, i));
					if (i < text.length) { setTimeout(step, 14); } else { resolve(); }
				}());
			});
		});
		return queue;
	}

	function stripCommand(q) {
		return String(q).replace(/^\s*(поиск|search)\s+/i, '');
	}

	setup.terminal = {
		run: function (raw) {
			var out = $('#term-output');
			var query = stripCommand(raw).trim();
			if (!query) { return; }
			var v = State.variables;
			var result = setup.searchRegistry(query, v);
			typeLine(out, '> ПОИСК ' + query.toUpperCase(), 'term-echo');
			result.lines.forEach(function (l) {
				typeLine(out, l, result.status === 'found' ? '' : 'term-warn');
			});
			if (result.status === 'found' && result.docId) {
				var doc = setup.documents[result.docId];
				if (v.tray.indexOf(result.docId) === -1 && v.kept.indexOf(result.docId) === -1) {
					v.tray.push(result.docId);
				}
				queue = queue.then(function () {
					$('<button type="button" class="term-open"></button>')
						.text('ОТКРЫТЬ · open “' + doc.title + '”')
						.on('click', function () { Engine.play(doc.passage); })
						.appendTo($('<div class="term-line"></div>').appendTo(out));
					out.scrollTop(out.prop('scrollHeight'));
				});
			}
		}
	};

	$(document).on(':passagedisplay', function (ev) {
		if (ev.passage.tags.indexOf('terminal') === -1) { return; }
		queue = Promise.resolve();
		var input = $('#term-input');
		$('#term-form').on('submit', function (e) {
			e.preventDefault();
			setup.terminal.run(input.val());
			input.val('');
		});
		$('.term-chip').on('click', function () {
			input.val($(this).attr('data-key')).trigger('focus');
		});
		input.trigger('focus');
	});
}());



