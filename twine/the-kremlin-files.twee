				'(Union Treaty · draft)',
				'ПОДПИСАНИЕ: 20.08.91',
				'ДОКУМЕНТ НЕ ВЫДАЁТСЯ / not issued to this terminal'
			],
			restrictedLines: []
		},
		{
			id: 'r-date',
			keys: ['14.08.91', '14.08.1991', '14 августа'],
			fromAct: 'act1',
