		'tsk-kpss':          { ru: 'ЦК КПСС', translit: 'Tse-Ka Ka-Pe-Es-Es', en: 'Central Committee of the Communist Party of the Soviet Union' },
		'obshchy-otdel':     { ru: 'Общий отдел', translit: 'Obshchiy otdel', en: 'General Department' },
